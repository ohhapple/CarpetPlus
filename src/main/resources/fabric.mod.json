{
  "schemaVersion": 1,
  "id": "carpetplus",
  "version": "${version}",
  "name": "CarpetPlus",
  "description": "随便写的一些小功能",
  "authors": ["ohhapple"],
  "contact": {
    "sources": "https://github.com/ohhapple/CarpetPlus",
    "issues": "https://github.com/ohhapple/CarpetPlus/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/carpetplus/icon.png",
  "environment": "*",
  "entrypoints": {

    "client": [
      "com.ohhapple.carpetplus.client.CarpetPLUSClient"
    ],
    "main": [
      "com.ohhapple.carpetplus.CarpetPlus"
    ]
  },
  "mixins": [
    "carpetplus.mixins.json"

  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "carpet": "${carpet_dependency}"
  },
  "accessWidener": "ohhapple.accesswidener"
}
